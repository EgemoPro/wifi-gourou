      "danger": "low",
      "roles": ["admin", "operator", "viewer"],
      "version": "1.0",
      "alias": ["list_users", "get_users"]
    },

    "hotspot.list_vouchers": {
      "type": "routeros",
      "script": "hotspot/list_vouchers.rsc",
      "mode": "import",
      "timeout": 10,
      "description": "Liste les vouchers hotspot générés",
      "params": [],
      "danger": "low",
      "roles": ["admin", "operator", "viewer"],
      "version": "1.0",
      "alias": ["list_vouchers", "get_vouchers"]
    },

    "hotspot.block_mac": {
      "type": "routeros",
      "script": "network/block_mac.rsc",
      "mode": "import",
      "timeout": 10,
      "description": "Bloque une adresse MAC via address-list",
      "params": [
        {"name": "mac", "required": true, "type": "string", "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$"},
        {"name": "comment", "required": false, "type": "string", "default": ""}
      ],
      "danger": "medium",
      "roles": ["admin"],
      "version": "1.0",
      "alias": ["block_mac"]
    },

    "hotspot.unblock_mac": {
      "type": "routeros",
      "script": "network/unblock_mac.rsc",
      "mode": "import",
      "timeout": 10,
      "description": "Débloque une adresse MAC",
      "params": [
        {"name": "mac", "required": true, "type": "string", "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$"}
      ],
      "danger": "medium",
      "roles": ["admin"],
      "version": "1.0",
      "alias": []
    },

    "hotspot.vouchers": {
      "type": "python",
      "handler": "generate_vouchers",
      "description": "Génère des codes vouchers hotspot (logique Python complexe)",
      "params": [
        {"name": "qty", "required": false, "type": "int", "default": 1, "min": 1, "max": 99},
        {"name": "profile", "required": false, "type": "string", "default": "default"},
        {"name": "user_mode", "required": false, "type": "string", "default": "voucher"},
        {"name": "time_limit", "required": false, "type": "string", "default": ""},
        {"name": "data_limit", "required": false, "type": "string", "default": ""},
        {"name": "price", "required": false, "type": "string", "default": ""},
        {"name": "login_url", "required": false, "type": "string", "default": ""},
        {"name": "name_length", "required": false, "type": "int", "default": 8},
        {"name": "charset", "required": false, "type": "string", "default": "ABCD"},
        {"name": "comment", "required": false, "type": "string", "default": ""}
      ],
      "danger": "low",
      "roles": ["admin", "operator"],
      "version": "2.0",
      "alias": ["generate_vouchers"]
    },

    "hotspot.setup_profile": {
      "type": "python",
      "handler": "setup_profile",
      "description": "Configure on-login script (expiration absolue) + scheduler cleanup pour un profile hotspot. Utilise l'API REST MikroTik.",
      "params": [
        {"name": "profile", "required": true, "type": "string", "description": "Nom du profile hotspot (ex: 2M-Limit)"},
        {"name": "validity", "required": false, "type": "string", "default": "1h", "description": "Durée de validité des vouchers (ex: 1h, 1d, 7d)"},
        {"name": "lock_mac", "required": false, "type": "string", "default": "no", "description": "yes/no — verrouiller le MAC address à la 1ère connexion"}
      ],
      "danger": "medium",
      "roles": ["admin"],
      "version": "1.0",
      "alias": ["setup_profile"]
    },

    "export_pdf": {
      "type": "python",
      "handler": "export_pdf",
      "description": "Exporte une liste de vouchers vers un fichier PDF imprimable (32 tickets/page, A4)",
      "params": [
        {"name": "vouchers", "required": true, "type": "json", "description": "Liste des vouchers à inclure dans le PDF"},
        {"name": "filename", "required": false, "type": "string", "default": "", "description": "Nom du fichier PDF (généré automatiquement si vide)"}
      ],
      "danger": "low",
      "roles": ["admin", "operator"],
      "version": "1.0",
      "alias": ["export_pdf"]
    },

    "profile.create": {
      "type": "routeros",
      "script": "hotspot/create_profile.rsc",
      "mode": "import",
      "timeout": 15,
      "description": "Crée un profil hotspot avec rate-limiting",
      "params": [
        {"name": "profileName", "required": true, "type": "string", "max_length": 32},
        {"name": "rate_limit", "required": false, "type": "string", "default": "1M/1M"},
        {"name": "shared_users", "required": false, "type": "int", "default": 1},
        {"name": "session_timeout", "required": false, "type": "string", "default": ""},
        {"name": "idle_timeout", "required": false, "type": "string", "default": ""},
        {"name": "data_limit", "required": false, "type": "string", "default": ""}
      ],
      "danger": "medium",
      "roles": ["admin"],
      "version": "2.0",
      "alias": ["create_profile"]
    },

    "profile.update": {
      "type": "python",
      "handler": "update_profile",
      "description": "Met à jour un profil hotspot existant",
      "params": [
        {"name": "name", "required": true, "type": "string"},
        {"name": "rate_limit", "required": false, "type": "string"},
        {"name": "shared_users", "required": false, "type": "int"},
        {"name": "session_timeout", "required": false, "type": "string"},
        {"name": "idle_timeout", "required": false, "type": "string"},
        {"name": "data_limit", "required": false, "type": "string"}
