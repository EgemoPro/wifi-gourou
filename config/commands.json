      "timeout": 10,
      "description": "Liste les utilisateurs hotspot actifs",
      "params": [],
      "danger": "low",
      "roles": ["admin", "operator", "viewer"],
      "version": "1.0",
      "alias": ["get_active_users"]
    },

    "hotspot.active_sessions": {
      "type": "routeros",
      "script": "hotspot/active_sessions.rsc",
      "mode": "import",
