{
  "meta": {
    "version": "2.0",
    "description": "Registre des actions wifizone-agent",
    "updated": "2026-07-17",
    "note": "Les actions de type 'routeros' exécutent un script .rsc via SSH. Les actions de type 'python' utilisent un handler Python (logique métier complexe)."
  },

  "actions": {

    "hotspot.create_user": {
      "type": "routeros",
      "script": "hotspot/add_user.rsc",
      "mode": "import",
      "timeout": 15,
      "description": "Crée un utilisateur hotspot",
      "params": [
        {"name": "username", "required": true, "type": "string", "max_length": 32},
        {"name": "password", "required": true, "type": "string", "max_length": 64},
        {"name": "profile", "required": false, "type": "string", "default": "default"},
        {"name": "comment", "required": false, "type": "string", "default": ""},
        {"name": "data_limit", "required": false, "type": "string", "default": ""},
        {"name": "time_limit", "required": false, "type": "string", "default": ""}
      ],
      "danger": "low",
      "roles": ["admin", "operator"],
      "version": "1.0",
      "alias": ["create_user"]
    },

    "hotspot.delete_user": {
      "type": "routeros",
      "script": "hotspot/delete_user.rsc",
      "mode": "import",
      "timeout": 15,
      "description": "Supprime un utilisateur hotspot",
      "params": [
        {"name": "username", "required": true, "type": "string", "max_length": 32}
      ],
      "danger": "medium",
      "roles": ["admin", "operator"],
      "version": "1.0",
      "alias": ["remove_user"]
    },

    "hotspot.disable_user": {
      "type": "routeros",
      "script": "hotspot/disable_user.rsc",
      "mode": "import",
      "timeout": 10,
      "description": "Désactive un utilisateur hotspot",
      "params": [
        {"name": "username", "required": true, "type": "string", "max_length": 32}
      ],
      "danger": "low",
      "roles": ["admin", "operator"],
      "version": "1.0",
      "alias": ["disable_user"]
    },

    "hotspot.enable_user": {
      "type": "routeros",
      "script": "hotspot/enable_user.rsc",
      "mode": "import",
      "timeout": 10,
      "description": "Réactive un utilisateur hotspot",
      "params": [
        {"name": "username", "required": true, "type": "string", "max_length": 32}
      ],
      "danger": "low",
      "roles": ["admin", "operator"],
      "version": "1.0",
      "alias": ["enable_user"]
    },

    "hotspot.kick_user": {
      "type": "routeros",
      "script": "hotspot/kick_user.rsc",
      "mode": "import",
      "timeout": 10,
      "description": "Déconnecte un utilisateur hotspot actif",
      "params": [
        {"name": "username", "required": true, "type": "string", "max_length": 32}
      ],
      "danger": "low",
      "roles": ["admin", "operator"],
      "version": "1.0",
      "alias": ["kick_client"]
    },

    "hotspot.list_active": {
      "type": "routeros",
      "script": "hotspot/list_active.rsc",
