# ============================================================
#  WIFIZONE Agent — Site B
#  Copier en .env et remplir les valeurs OBLIGATOIRES
# ============================================================

# ── OBLIGATOIRES ─────────────────────────────────────────────
SITE_ID=SITE_B
SITE_NAME=WIFIZONE Chateau
MIKROTIK_HOST=192.168.20.1
MIKROTIK_PASSWORD=CHANGE_ME
CENTRAL_HOST=172.22.77.29
CENTRAL_API_KEY=CHANGE_ME

# ── OPTIONNEL — IP Tailscale de ce PC (auto-détectée si vide) ─
AGENT_TAILSCALE_IP=

# ── OPTIONNELS (valeurs par défaut suffisent) ─────────────────
MIKROTIK_PORT=8728
MIKROTIK_SSH_PORT=22         # Port SSH MikroTik (changer si différent de 22)
MIKROTIK_USER=api-agent
MIKROTIK_ROS_VERSION=6
CENTRAL_PORT=5678
ALERT_PORT=9000
COMMAND_PORT=9001
INTERVAL_METRICS=300
INTERVAL_CLIENTS=60
INTERVAL_BANDWIDTH=120
INTERVAL_OFFLINE=120
INTERVAL_USER_BLOAT=3600
INTERVAL_SCHEDULERS=3600
BACKUP_HOUR=2
REGISTER_RETRY=60
THRESHOLD_CPU=80
THRESHOLD_CPU_CYCLES=2
THRESHOLD_BANDWIDTH_MB=500
THRESHOLD_MAX_USERS=200
THRESHOLD_MAX_SCHEDULERS=20
THRESHOLD_OFFLINE_RETRIES=3
